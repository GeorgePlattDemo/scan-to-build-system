{
  "name": "stb",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Scan-to-Build local application subtree. Build 1 locked entry over the Build 0 foundation.",
  "engines": {
    "node": "22.23.2"
  },
  "scripts": {
    "start": "node server/main.mjs",
    "test:unit": "node --test --test-concurrency=1 test/unit/*.test.mjs",
    "test:browser": "playwright test --config test/playwright.config.mjs",
    "test:boundaries": "node --test --test-concurrency=1 test/boundaries/*.test.mjs",
    "test:store": "node --test --test-concurrency=1 test/store/*.test.mjs",
    "test:vertical": "playwright test --config test/playwright.vertical.config.mjs",
    "trial:published-jobs": "node ops/run-published-job.mjs --all",
    "start:hosted-store": "node ops/start-hosted-store.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0"
  },
  "dependencies": {
    "pdfjs-dist": "4.10.38"
  }
}
